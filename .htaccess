# 1. Запрет листинга содержимого каталогов
Options -Indexes
DirectoryIndex index.php index.html

# 2. Разрешить доступ к страницам и статике сайта
Require all granted

# 3. Защита конфигов, секретов, дампов и служебных файлов
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|env|envrc|git.*|zip)|~)$">
    Require all denied
</FilesMatch>

<Files "db.local.php">
    Require all denied
</Files>

<Files "db.php">
    Require all denied
</Files>

# 4. HTTP Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
